diff --git a/gtk/mixer.c b/gtk/mixer.c
index e2a9ef5..d88c739 100644
--- a/gtk/mixer.c
+++ b/gtk/mixer.c
@@ -2,6 +2,7 @@
 #include <stdio.h>
 #include <gtk/gtk.h> // XXX
 #include <gio/gio.h>
+#include <gio/gnetworking.h>
 #include "mixer.h"
 #include "../osc.h"
 
@@ -125,12 +126,16 @@ on_osc_data(GDatagramBased *socket, GIOCondition condition, gpointer ptr)
 	gssize ret;
 
 	self = OSCMIX_MIXER(ptr);
-	ret = g_socket_receive(G_SOCKET(socket), (gchar *)buf, sizeof buf, NULL, NULL);
-	msg.err = NULL;
-	msg.buf = buf;
-	msg.end = buf + ret;
-	msg.type = NULL;
-	handle_packet(self, &msg);
+	/* Drain every queued datagram per wakeup: oscmix emits thousands of
+	 * messages on /refresh plus continuous meter levels, and handling one
+	 * per main loop iteration lets the socket buffer overflow. */
+	while ((ret = g_socket_receive_with_blocking(G_SOCKET(socket), (gchar *)buf, sizeof buf, FALSE, NULL, NULL)) > 0) {
+		msg.err = NULL;
+		msg.buf = buf;
+		msg.end = buf + ret;
+		msg.type = NULL;
+		handle_packet(self, &msg);
+	}
 	return true;
 }
 
@@ -143,6 +148,8 @@ setup_connection(Mixer *self)
 		g_object_unref(self->socket);
 	self->socket = g_socket_new(g_socket_address_get_family(self->recv_address), G_SOCKET_TYPE_DATAGRAM, G_SOCKET_PROTOCOL_UDP, NULL);
 	g_socket_bind(self->socket, self->recv_address, false, NULL);
+	/* Absorb the /refresh burst; the kernel caps this at net.core.rmem_max. */
+	g_socket_set_option(self->socket, SOL_SOCKET, SO_RCVBUF, 4 << 20, NULL);
 	self->source = g_socket_create_source(self->socket, G_IO_IN, NULL);
 	g_source_set_callback(self->source, (GSourceFunc)on_osc_data, self, NULL);
 	g_source_attach(self->source, NULL);
